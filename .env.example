# Скопируйте этот файл в .env и подставьте свои значения.
# НЕ коммитьте реальный .env в репозиторий (он уже в .gitignore).

# Базовый адрес Open Library API.
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Таймаут запросов к внешнему API в секундах.
OPEN_LIBRARY_TIMEOUT=5

# Время жизни кеша «популярных книг» в секундах (10 минут по умолчанию).
POPULAR_CACHE_TTL=600

# Сколько популярных книг запрашивать с главной страницы.
POPULAR_LIMIT=12
